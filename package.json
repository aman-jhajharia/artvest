{
  "name": "artvest-monorepo",
  "version": "0.1.0",
  "description": "ArtVest: Discover Talent. Build Teams. Back Ideas. — B.Tech CSE Major Project (PR1107)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "db:local": "npm --prefix backend run db:local",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
